API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://tedixhunt:local-development-only@127.0.0.1:5432/tedixhunt
PGPOOL_MAX=10
# Existing Mongo-backed routes need this until migrated in later steps.
MONGODB_URI=
# Exact browser origin for CORS/CSRF. Use the HTTPS FE origin when deployed.
WEB_ORIGIN=http://localhost:5173
# New PostgreSQL auth uses opaque tokens, not JWT_SECRET.
# Legacy organization middleware still uses JWT_SECRET until migrated.
JWT_SECRET=replace-with-a-secure-secret
