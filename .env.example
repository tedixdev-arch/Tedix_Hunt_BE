NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Required: supply a private, securely generated value (see README). Blank fails startup.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# Supply your local PostgreSQL connection string privately.
DATABASE_URL=
WEB_ORIGIN=http://localhost:5173

# QA-02: disabled in every environment by default. Operator + PO approval required.
AUTH_ABUSE_ENABLED=false
# Omit to trust no proxies. EXAMPLE ONLY: replace with verified ingress addresses.
# AUTH_TRUSTED_PROXIES=192.0.2.10/32,2001:db8::10/128
AUTH_ABUSE_MAX_ENTRIES=20000
# Token-bucket capacities and full-refill windows (milliseconds), per process.
AUTH_ABUSE_LOGIN_NETWORK_CAPACITY=120
AUTH_ABUSE_LOGIN_NETWORK_WINDOW_MS=60000
AUTH_ABUSE_LOGIN_ACCOUNT_CAPACITY=10
AUTH_ABUSE_LOGIN_ACCOUNT_WINDOW_MS=300000
AUTH_ABUSE_REGISTRATION_CAPACITY=60
AUTH_ABUSE_REGISTRATION_WINDOW_MS=60000
AUTH_ABUSE_GUEST_CAPACITY=80
AUTH_ABUSE_GUEST_WINDOW_MS=60000
AUTH_ABUSE_ACTIVATION_CAPACITY=60
AUTH_ABUSE_ACTIVATION_WINDOW_MS=60000
AUTH_ABUSE_REFRESH_CAPACITY=240
AUTH_ABUSE_REFRESH_WINDOW_MS=60000
